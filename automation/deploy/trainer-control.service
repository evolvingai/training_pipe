[Unit]
Description=Trainer Automation control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trainer
Group=trainer
WorkingDirectory=/opt/trainer
EnvironmentFile=/etc/trainer-automation/control.env
ExecStart=/usr/bin/node /opt/trainer/automation/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/trainer-automation

[Install]
WantedBy=multi-user.target
